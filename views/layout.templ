package views

templ Layout(title string, authed bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Cockadeck</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="icon" href="/static/favicon.svg" type="image/svg+xml"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body>
			<header class="topbar">
				<a class="brand" href="/">COCKADECK<span aria-hidden="true">&nbsp;◤</span></a>
				if authed {
					<nav class="nav">
						<a class="bracket" href="/search">Search</a>
						<a class="bracket" href="/decks">Decks</a>
						<form method="post" action="/logout" class="inline">
							<button type="submit" class="bracket">Log out</button>
						</form>
						<span class="sys-status">STATUS: ONLINE <span class="cursor" aria-hidden="true">█</span></span>
					</nav>
				} else {
					<span class="sys-status">SYS.AUTH <span class="cursor" aria-hidden="true">█</span></span>
				}
			</header>
			<main class="container">
				{ children... }
			</main>
			<footer class="statusline">
				<span>COCKADECK*/*MTG.REGISTRY*/*SCRYFALL.API</span>
				<span>LOCAL.DB · © 2026</span>
			</footer>
			<dialog id="confirm-dialog" class="confirm" aria-labelledby="confirm-dialog-msg">
				<p class="dialog-tag">Confirm.Action</p>
				<p id="confirm-dialog-msg" class="confirm-msg"></p>
				<div class="confirm-actions">
					<button type="button" class="btn-ghost" data-confirm-cancel>Cancel</button>
					<button type="button" class="btn-confirm" data-confirm-ok>Delete</button>
				</div>
			</dialog>
		</body>
	</html>
}
