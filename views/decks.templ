package views

import (
	"cockadeck/internal/store/sqlcgen"
	"fmt"
)

templ DecksPage(decks []sqlcgen.ListDecksRow, colors map[int64]string, errMsg string) {
	@Layout("Decks", true) {
		<section class="panel">
			<header class="section-head">
				<span class="section-index">01</span>
				<h1>Deck Registry</h1>
				<span class="section-rule" aria-hidden="true"></span>
			</header>
			if errMsg != "" {
				<p class="alert alert-error">{ errMsg }</p>
			}
			<form method="post" action="/decks" class="form-inline">
				<input type="text" name="name" placeholder="Deck name" required/>
				<label class="form-tag">Format
				<select name="format">
					<option value="40-card">40-card</option>
					<option value="commander">commander</option>
				</select>
				</label>
				<input type="text" name="description" placeholder="Description (optional)"/>
				<button class="btn" type="submit">New deck</button>
			</form>
		</section>
		<div class="deck-list">
			for i, d := range decks {
				<a class="deck-item" href={ deckURL(d.ID) }>
					<span class="row-index">{ fmt.Sprintf("%03d", i+1) }</span>
					<span class="deck-item-name">{ d.Name }</span>
					if cost := colors[d.ID]; cost != "" {
						@ManaCost(cost)
					}
					<span class="deck-item-tail">
						<span class="badge">{ d.Format }</span>
						<span class="deck-count">
							{ fmt.Sprintf("%d", d.CardCount) }
							<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true">
								<rect x="2.5" y="2.8" width="7" height="9.5" rx="1" transform="rotate(-14 6 8)"/>
								<rect x="6.5" y="3.2" width="7" height="9.5" rx="1" transform="rotate(12 10 8)"/>
							</svg>
						</span>
					</span>
				</a>
			}
		</div>
		if len(decks) == 0 {
			<p class="muted small">{ "// No decks on record — create one above." }</p>
		}
	}
}
