package views

import "cockadeck/internal/store/sqlcgen"

templ SearchPage(set, num string, card *sqlcgen.Card, decks []sqlcgen.ListDecksRow, errMsg string) {
	@Layout("Search", true) {
		<section class="panel">
			<h1 class="section-label">Card Search</h1>
			<form action="/search" method="get" hx-get="/search/results" hx-target="#results" class="form-inline">
				<input type="text" name="set" placeholder="Set code" value={ set } required autocomplete="off"/>
				<input type="text" name="num" placeholder="Collector #" value={ num } required autocomplete="off"/>
				<button class="btn" type="submit">Search</button>
			</form>
		</section>
		<div id="results">
			@SearchResults(card, decks, errMsg)
		</div>
	}
}

templ SearchResults(card *sqlcgen.Card, decks []sqlcgen.ListDecksRow, errMsg string) {
	if errMsg != "" {
		<p class="alert alert-error">{ errMsg }</p>
	}
	if card != nil {
		@CardResult(*card, decks)
	}
}

templ CardResult(card sqlcgen.Card, decks []sqlcgen.ListDecksRow) {
	<div class="panel card-result">
		<img class="card-img" src={ card.ImageUri } alt={ card.Name } loading="lazy"/>
		<div class="card-meta">
			<h2 class="card-name">{ card.Name }</h2>
			if card.TypeLine.Valid {
				<p class="muted">{ card.TypeLine.String }</p>
			}
			<p class="muted">{ card.SetName } <span class="dim">·</span> #{ card.CollectorNumber }</p>
			<p>
				<span class="badge">{ card.Rarity }</span>
				if card.ManaCost.Valid {
					<span class="mana-cost">{ card.ManaCost.String }</span>
				}
			</p>
			<details class="add-popover">
				<summary class="btn">Add to deck</summary>
				<div class="add-forms">
					if len(decks) == 0 {
						<p class="muted">No decks yet — <a href="/decks">create one</a>.</p>
					}
					for _, d := range decks {
						<form class="add-form" hx-post={ deckCardsURL(d.ID) } hx-target="find .add-status" hx-swap="innerHTML">
							<input type="hidden" name="card_id" value={ card.ID }/>
							<span class="add-deck-name">{ d.Name }</span>
							<select name="zone">
								for _, z := range zoneOrder(d.Format) {
									<option value={ z }>{ z }</option>
								}
							</select>
							<input class="qty-input" type="number" name="quantity" value="1" min="1"/>
							<button class="btn btn-sm" type="submit">Add</button>
							<span class="add-status"></span>
						</form>
					}
				</div>
			</details>
		</div>
	</div>
}

templ AddCardStatus(ok bool, msg string) {
	if ok {
		<span class="added-ok">&#10003; { msg }</span>
	} else {
		<span class="added-err">{ msg }</span>
	}
}
