package views

import (
	"cockadeck/internal/store/sqlcgen"
	"fmt"
	"strconv"
)

templ DeckPage(deck sqlcgen.Deck, rows []sqlcgen.ListDeckCardsRow, f DeckFilters, errMsg string) {
	@Layout(deck.Name, true) {
		<section class="panel deck-head">
			<span class="meta-label">Subject.ID</span>
			<div class="deck-head-top">
				<div>
					<h1 class="deck-title">{ deck.Name }</h1>
					<div class="deck-meta">
						<span class="badge">{ deck.Format }</span>
						<span>Size.{ fmt.Sprintf("%03d", totalCards(rows)) }</span>
						<span>Upd.{ shortDate(deck.UpdatedAt) }</span>
					</div>
				</div>
				<div class="deck-actions">
					<a class="bracket" href={ deckURL(deck.ID) + "/export.cod" } download>Export.cod</a>
					<button class="bracket bracket-danger" hx-delete={ deckURL(deck.ID) }
						hx-confirm="Delete %s? This can’t be undone." data-confirm-subject={ deck.Name }
						data-confirm-label="Delete">Delete</button>
				</div>
			</div>
			if deck.Description != "" {
				<p class="muted">{ deck.Description }</p>
			}
			<details class="deck-edit">
				<summary class="bracket">Edit deck</summary>
				<form method="post" action={ deckURL(deck.ID) } class="form-inline">
					<input type="text" name="name" value={ deck.Name } required/>
					<select name="format">
						<option value="40-card" selected?={ deck.Format == "40-card" }>40-card</option>
						<option value="commander" selected?={ deck.Format == "commander" }>commander</option>
					</select>
					<input type="text" name="description" value={ deck.Description } placeholder="Description"/>
					<button class="btn" type="submit">Save</button>
				</form>
			</details>
		</section>
		<form id="deck-filters" class="filters" method="get" action={ deckURL(deck.ID) }
			hx-get={ deckURL(deck.ID) } hx-target="#deck-cards" hx-swap="innerMorph"
			hx-trigger="input delay:300ms, change" hx-push-url="true">
			<input type="text" name="set" placeholder="Set (code or name)" value={ f.Set }/>
			<select name="rarity">
				<option value="">Any rarity</option>
				for _, r := range rarities {
					<option value={ r } selected?={ f.Rarity == r }>{ r }</option>
				}
			</select>
			<div class="num-input num-md">
				<input type="number" name="cmc" step="0.5" min="0" placeholder="Cost" value={ f.CMC }/>
				<button type="button" class="num-btn" data-step="-1" aria-label="Decrease">&minus;</button>
				<button type="button" class="num-btn" data-step="1" aria-label="Increase">+</button>
			</div>
		</form>
		<div id="deck-cards">
			@DeckCardList(deck, rows, errMsg)
		</div>
	}
}

templ DeckCardList(deck sqlcgen.Deck, rows []sqlcgen.ListDeckCardsRow, errMsg string) {
	if errMsg != "" {
		<p class="alert alert-error">{ errMsg }</p>
	}
	if len(rows) == 0 {
		<p class="muted small">{ "// No cards on record — " }<a href="/search">run a query</a>{ " to add." }</p>
	}
	for i, zone := range zoneOrder(deck.Format) {
		if len(zoneRows(rows, zone)) > 0 {
			<section class="zone-group">
				<h2 class="zone-label"><span class="zone-index">Zone.{ fmt.Sprintf("%02d", i+1) }</span> — { zone } <span class="muted">[ { zoneTotal(rows, zone) } ]</span></h2>
				for j, row := range zoneRows(rows, zone) {
					@DeckCardRow(deck, row, j+1)
				}
			</section>
		}
	}
}

templ CardRow(idx int, imgUri, name string) {
	<div class="deck-row">
		<span class="row-index">{ fmt.Sprintf("%02d", idx) }</span>
		<div class="card-thumb-wrap">
			<img class="card-thumb" src={ imgUri } alt={ name } loading="lazy"/>
			<img class="card-preview" src={ imgUri } alt="" loading="lazy" aria-hidden="true"/>
		</div>
		{ children... }
	</div>
}

templ DeckCardRow(deck sqlcgen.Deck, row sqlcgen.ListDeckCardsRow, idx int) {
	@CardRow(idx, row.ImageUri, row.Name) {
		<div class="deck-row-info">
			<span class="deck-row-name">
				{ row.Name }
				if row.Zone == "commander" {
					<span class="badge badge-commander">commander</span>
				}
			</span>
			<span class="muted small">
				{ row.SetName } · #{ row.CollectorNumber } · <span class={ "rarity-" + row.Rarity }>{ row.Rarity }</span>
				if row.ManaCost.Valid {
					<span class="dim">·</span>
					@ManaCost(row.ManaCost.String)
				}
			</span>
		</div>
		<div class="deck-row-ctl">
			<form class="qty-ctl" hx-patch={ deckCardRowURL(deck.ID, row.CardID, row.Zone) } { cardListSwap... }>
				<span class="qty">{ row.Quantity }</span>
				<button type="submit" name="quantity" value={ strconv.FormatInt(row.Quantity-1, 10) }>&minus;</button>
				<button type="submit" name="quantity" value={ strconv.FormatInt(row.Quantity+1, 10) }>+</button>
			</form>
			<select class="zone-select" name="new_zone" hx-patch={ deckCardRowURL(deck.ID, row.CardID, row.Zone) } { cardListSwap... }>
				for _, z := range zoneOrder(deck.Format) {
					<option value={ z } selected?={ z == row.Zone }>{ z }</option>
				}
			</select>
			<button class="btn-icon" hx-delete={ deckCardRowURL(deck.ID, row.CardID, row.Zone) } { cardListSwap... }
				hx-confirm="Remove %s from the deck?" data-confirm-subject={ row.Name } data-confirm-label="Remove"
				aria-label={ "Remove " + row.Name }>&times;</button>
		</div>
	}
}
